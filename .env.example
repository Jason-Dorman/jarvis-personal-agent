# Copy to .env and fill in. .env is gitignored. Never put keys anywhere else.

# Required: the brain (Claude Agent SDK)
ANTHROPIC_API_KEY=

# Optional: CoinGecko demo/pro key. Leave blank to use the keyless free tier.
COINGECKO_API_KEY=

# No keys needed: DefiLlama (pegs), yfinance (stocks/ETFs/rates), RSS feeds (news)
